#!/usr/bin/env bash
# holdfast — 단일 진입점.
#
# load-test/scripts/ 아래 스크립트들과 gradle·docker compose를 서브커맨드로 묶는다.
# **아무것도 대체하지 않는다.** 각 스크립트는 지금처럼 직접 부를 수 있고, 이
# 파일은 "무엇을 언제 쓰는가"를 한자리에 모으고 경로를 대신 쳐 줄 뿐이다.
#
#   ./holdfast              서브커맨드 목록
#   ./holdfast <커맨드> -h  그 커맨드의 도움말(위임 대상의 것을 보여준다)
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$ROOT"
S="$ROOT/load-test/scripts"

# Git Bash가 /scenarios/... 같은 인자를 Windows 경로로 바꾸는 것을 막는다.
# 개별 스크립트도 각자 걸지만, 여기서 걸어 두면 위임 전에 이미 적용된다.
export MSYS_NO_PATHCONV=1

# node는 반드시 env를 거쳐 부른다. Git Bash가 mintty에서 node를 winpty로 별칭
# 처리해, 출력을 리다이렉트하면 "stdin is not a tty"로 실패한다
# (load-test/README의 Windows 주의). env는 셸 별칭을 지나지 않는다.
node_run() { env -u MSYS_NO_PATHCONV node "$@"; }

# **전략 다섯.** 정본은 각 구현의 `@ConditionalOnProperty(havingValue = ...)`이고
# 이 목록은 그것을 옮긴 것이다. 둘이 어긋나면
# `api/.../reservation/StrategyArgumentTest`가 깨진다 — 유효 값을 두 곳에서
# 지키게 됐으므로 그것을 테스트로 묶는다(erd.md 4절의 원칙).
STRATEGIES="none pessimistic optimistic unique redis"

# **시연 준비는 열기에 실패해도 끝까지 간다.** 아래 둘(브라우저·대본)은 전부
# "되면 좋고 안 되면 알리고 넘어간다"로 만들었다. 준비 명령이 편의 기능 하나
# 때문에 멈추면, 그것이 발표 직전에 가장 나쁜 실패다.

# 브라우저를 여는 명령. 없으면 빈 값이고, 그때는 주소만 출력한다.
#
#   Windows/Git Bash → start (cmd 내장이라 실행 파일이 아니다. cmd //c 로 부른다)
#   macOS            → open
#   리눅스           → xdg-open
# cmd.exe 를 부를 때 MSYS_NO_PATHCONV 를 지운다. **이 스크립트는 위에서 그것을
# 켜 두는데, 켜져 있으면 `//c` 가 `/c` 로 접히지 않아 cmd 가 스위치를 못 알아보고
# 아무 창도 뜨지 않는다.** node_run 과 같은 이유의 같은 처리다 —
# MSYS_NO_PATHCONV 는 "값이 있으면 비활성화"라 =0 으로는 안 풀리고 env -u 로
# 지워야 한다(load-test/scripts/run.sh 의 같은 주석).
#
# 지우면 파일 경로도 함께 변환된다 — `/e/Project/...` 가 `E:\Project\...` 가
# 되어 cmd 가 그대로 연다. 그것도 필요한 동작이다.
cmd_run() { env -u MSYS_NO_PATHCONV cmd.exe "$@"; }

opener() {
  if command -v cmd.exe >/dev/null 2>&1; then echo "cmd"; return; fi
  if command -v open    >/dev/null 2>&1; then echo "open"; return; fi
  if command -v xdg-open >/dev/null 2>&1; then echo "xdg-open"; return; fi
  echo ""
}

open_url() {  # $1 = 주소 또는 파일 경로
  case "$OPENER" in
    cmd)
      # start 는 첫 인자를 창 제목으로 먹는다. 빈 제목을 하나 넣어 준다.
      # //c 는 MSYS 경로 변환을 피하는 표기다(load-test/README의 Windows 주의).
      cmd_run //c start "" "$1" >/dev/null 2>&1 || return 1 ;;
    open)     open "$1"     >/dev/null 2>&1 || return 1 ;;
    xdg-open) xdg-open "$1" >/dev/null 2>&1 || return 1 ;;
    *) return 1 ;;
  esac
  return 0
}

# **대본을 렌더링해 연다.** 마크다운 원문으로 보는 것과 다르다 — demo-script.md는
# 표 18줄·코드펜스·인용이 많아 원문 가독성이 특히 나쁘다.
#
# **렌더러에 의존성이 없다**(tools/render-md.mjs). npx marked 는 첫 실행에 네트워크를
# 요구하는데, 발표장에 네트워크가 없을 수 있다 — 측정이 원격 import를 배제한 것과
# 같은 이유이며 발표에는 더 강하게 적용된다.
#
# **node가 없거나 렌더링이 실패하면 원문을 연다.** 그것도 안 되면 경로를 알린다.
open_script() {
  local md="$ROOT/docs/demo-script.md"
  local html="$ROOT/build/demo-script.html"

  if command -v node >/dev/null 2>&1; then
    mkdir -p "$ROOT/build"
    if node_run "$ROOT/tools/render-md.mjs" "$md" "$html" "시연 대본" >/dev/null 2>&1; then
      if open_url "$html"; then
        echo "[holdfast]   대본 (렌더링)  build/demo-script.html"
        return 0
      fi
      echo "[holdfast]   대본을 렌더링했다 — build/demo-script.html (직접 열어라)"
      return 0
    fi
    echo "[holdfast]   !! 대본 렌더링에 실패했다. 원문으로 간다." >&2
  else
    echo "[holdfast]   !! node가 없어 대본을 렌더링하지 못한다. 원문으로 간다." >&2
  fi

  if open_url "$md"; then
    echo "[holdfast]   대본 (원문)     docs/demo-script.md"
  else
    echo "[holdfast]   대본은 docs/demo-script.md 다. 직접 열어라."
  fi
}

# **여는 탭은 대본이 정한 셋이다.** demo-script.md 0절의 탭 표가 정본이고
# 1·2·3절이 그 번호로 화면을 부른다("탭 2 — /demo/race"). 다섯을 열지 않는다 —
# 아래 "시연 주소"에 출력하는 다섯은 참조 목록이지 탭 배치가 아니고, 좌석맵은
# 탭 1에서 프로그램 목록을 타고 들어간다.
#
# **여는 순서가 곧 탭 번호다.** 대본이 번호로 부르므로 왼쪽부터 1·2·3이 되게 한다.
DEMO_TABS="http://localhost:8080/ http://localhost:8080/demo/race http://localhost:8080/admin/programs"

open_demo_tabs() {
  local n=0 failed=0
  for url in $DEMO_TABS; do
    n=$((n + 1))
    open_url "$url" || failed=1
  done
  [ "$failed" = "0" ] && return 0
  return 1
}

# **전략 인자를 검증한다.** 안 하면 없는 이름이 그대로 HOLDFAST_STRATEGY로 나가고,
# 앱은 조건에 맞는 빈이 하나도 없어 기동에 실패한다(#143).
#
# **위치 인자를 하나로 제한하는 것이 절반이다.** 예전 파싱은 몇 개든 받아
# **마지막 것이 앞의 것을 조용히 덮었다.** `seed <시나리오> <전략>`은 인자를 둘
# 받고 순서도 반대라, 그 손버릇으로 `up none extreme`을 치면 전략이 `extreme`이
# 된다 — `extreme`은 전략이 아니라 경합도 시나리오다(concurrency-spec 7.2).
#
# 전역 `strategy`·`build`를 채운다.
parse_strategy_args() {
  build=""
  strategy=""
  for a in "$@"; do
    case "$a" in
      --build) build="--build" ;;
      -*)
        echo "[holdfast] !! 모르는 옵션이다: $a" >&2
        exit 2
        ;;
      *)
        if [ -n "$strategy" ]; then
          echo "[holdfast] !! 인자가 둘이다: '$strategy' 와 '$a'" >&2
          echo "[holdfast]    이 커맨드는 전략 하나만 받는다. 시나리오는 받지 않는다." >&2
          echo "[holdfast]    seed·measure 는 시나리오를 받으므로 인자 수가 다르다:" >&2
          echo "[holdfast]      ./holdfast seed <시나리오> <전략>   (시나리오가 먼저다)" >&2
          exit 2
        fi
        strategy="$a"
        ;;
    esac
  done

  [ -z "$strategy" ] && return 0
  case " $STRATEGIES " in
    *" $strategy "*) return 0 ;;
  esac

  echo "[holdfast] !! '$strategy' 는 전략이 아니다." >&2
  echo "[holdfast]    전략: $STRATEGIES" >&2
  case " low high extreme sustained " in
    *" $strategy "*)
      echo "[holdfast]    '$strategy' 는 **경합도 시나리오**다(concurrency-spec 7.2)." >&2
      echo "[holdfast]    시나리오를 쓰는 곳은 seed·measure·deadlock 쪽이다." >&2
      ;;
  esac
  echo "[holdfast]    그대로 띄우면 조건에 맞는 전략 빈이 없어 앱이 기동하지 못한다(#143)." >&2
  exit 2
}

usage() {
  cat <<'USAGE'
holdfast — 실행 진입점

  ./holdfast <커맨드> [인자...]

스택
  up [전략] [--build]  앱 2대 + DB + Redis + nginx 기동. 전략을 주면 그것으로 띄운다
  rebuild [전략]       up --build 와 같다. **코드를 고쳤으면 이쪽이다**
                       전략은 하나만 받는다 — none|pessimistic|optimistic|unique|redis
                       시나리오(low·high·extreme)를 여기 주면 거부한다(#143)
  demo [전략] [--build] [--no-open]
                       시연 준비 — 기동 + 시드 + **대본 탭 셋과 대본을 연다**
                       --no-open 이면 주소만 출력한다
  down                 전부 내린다
  ps                   컨테이너 상태
  logs [서비스]        로그 (기본 app1)

측정
  seed <시나리오> <전략>   시드 초기화 (U-2는 none에서만 제거된다)
  measure [...]            측정 실행기. 인자 없이 대화형, --preset 지원
  deadlock <전략> [시나리오]  데드락 회피 검증 (7.2.1)
  sustained <전략>         지속 경합 시나리오 (7.2.2)
  verify                   DB 검증 쿼리 V-1~V-5
  summary [...]            결과 요약 표 (기본: 최신 세션)

개발
  test [패턴]          cd api && ./gradlew test. 패턴을 주면 --tests로 넘긴다
  build                cd api && ./gradlew build -x test

문서
  bundle [출력파일]    판단에 필요한 문서만 zip으로 묶는다 (다른 세션에 넘길 용도)

시연
  demo [전략] [--build]  기동 + 시드 + 화면 주소 안내
  strategy <이름>      전략을 바꿔 앱만 다시 띄운다 (약 13초)
  race                 동시 요청 데모 주소를 알려준다

  각 커맨드에 -h 를 주면 위임 대상의 도움말이 나온다(measure·deadlock 등).

PATH에 넣고 싶으면:
  export PATH="$PATH:/경로/holdfast"   # 저장소 루트를 PATH에 넣고 `holdfast` 로 호출
USAGE
}

# 시연·시드의 기본값. extreme(1석/200명)이 동시성 시연에 가장 선명하다.
DEMO_SCENARIO="${DEMO_SCENARIO:-extreme}"

# **시연은 홀드 TTL을 운영값으로 쓴다.** docker-compose의 기본 10초는 부하 측정용
# 고정 변수이고(concurrency-spec 7.3 — 경합을 빨리 관찰하려는 값), 시연에서는
# 설명하는 사이에 좌석이 풀려 버린다. 3절이 정한 운영값 5분을 쓴다.
DEMO_HOLD_TTL_SECONDS="${DEMO_HOLD_TTL_SECONDS:-300}"

# ── 시연 스택 둘 (#179) ──────────────────────────────────────────────────
# **발표장에 터미널이 없다.** 서버는 집 PC에 있고 발표자는 발표장에 있어
# (infra-decision.md 2.1), 1절 끝에서 `./holdfast strategy pessimistic` 을 칠
# 셸이 없다(#178이 남긴 미결). 그래서 **두 전략을 미리 띄워 두고 주소로
# 가른다** — 전환이 탭 전환이 된다.
#
# **DB를 반드시 나눈다. 이것은 선택이 아니다.** U-2(ux_seat_hold_active)는
# 스키마 객체이고 none에서만 없다(erd.md 3.1). 한 DB가 그 인덱스를 갖고 동시에
# 안 가질 수는 없어서, 공유하면 none이 unique처럼 보이고 **1절이 통째로 죽는다.**
# scope-m4 8절이 위임 프록시를 기각한 근거와 같은 자리다.
#
# **가르는 수단은 COMPOSE_PROJECT_NAME 하나다.** docker compose를 부르는 모든
# 곳이 그 값을 따른다 — warn_stopped·wait_healthy·reload_nginx는 물론
# seed.sh(load-test/, 최건 소유)도 그대로 동작한다. **고칠 파일이 없다.**
DEMO_STACKS="${DEMO_STACKS:-none pessimistic}"

use_stack() {
  case "$1" in
    none)
      export COMPOSE_PROJECT_NAME="holdfast-none"
      export NGINX_PORT_HOST=8080 APP1_PORT_HOST=18081 APP2_PORT_HOST=18082
      export DB_PORT_HOST=5432 REDIS_PORT_HOST=6379
      ;;
    pessimistic)
      export COMPOSE_PROJECT_NAME="holdfast-pess"
      export NGINX_PORT_HOST=8090 APP1_PORT_HOST=18091 APP2_PORT_HOST=18092
      export DB_PORT_HOST=5442 REDIS_PORT_HOST=6389
      ;;
    *) echo "[holdfast] 시연 스택이 아니다: $1" >&2; return 2 ;;
  esac
}

# ── 터널 검증 (#174) ─────────────────────────────────────────────────────
TUNNEL_HOSTS="${TUNNEL_HOSTS:-demo-none.inhalab.cloud demo-pess.inhalab.cloud demo-admin.inhalab.cloud}"

# **밖에서 익명으로 쳐 본다.** 안에서 보는 것은 의미가 없다 — 2.1이 적은 대로
# **발표자는 자기 화면으로 보므로 정상으로 보이고**, 틀린 것은 밖에서만 드러난다.
#
# **보는 것은 "앱이 나오느냐" 하나다.** 세 호스트명 모두 Cloudflare Access 뒤에
# 있으므로, 인증 없이 앱 화면이 오면 **Access가 안 걸린 것**이다. 302(로그인으로
# 보냄)·403·404는 정상이고 **200에 앱 HTML이면 실패**다.
#
# **경로 허용 목록은 이 검사가 못 본다.** Access를 지나야 앱에 닿는데 스크립트에는
# 세션이 없다. 그쪽은 리허설에서 브라우저로 확인한다 — 이 함수가 지키는 것은
# **"밖에서 아무나 들어오느냐"** 한 겹이다.
tunnel_verify() {
  local host code body failed=0
  echo "[holdfast] 밖에서 확인한다 — 인증 없이 앱이 나오면 실패다."
  for host in $TUNNEL_HOSTS; do
    code="$(curl -s -o /dev/null -w '%{http_code}' --max-time 15 "https://$host/" 2>/dev/null || echo 000)"
    case "$code" in
      000)
        echo "[holdfast]   $host  응답 없음 ($code) — 전파 중이거나 터널이 안 붙었다" >&2
        failed=1 ;;
      200)
        # 200이어도 Access 로그인 화면일 수 있다. 앱인지 본문으로 가른다.
        body="$(curl -s --max-time 15 "https://$host/" 2>/dev/null | head -c 4000)"
        if printf '%s' "$body" | grep -qi 'holdfast'; then
          echo "[holdfast]   $host  **앱이 그대로 나온다 (200)** — Access가 안 걸렸다" >&2
          failed=1
        else
          echo "[holdfast]   $host  200 (Access 화면) — 정상"
        fi ;;
      *)
        echo "[holdfast]   $host  $code — 정상 (앱에 못 닿는다)" ;;
    esac
  done
  [ "$failed" = "0" ] && { echo "[holdfast] 확인 통과."; return 0; }
  return 1
}

# 떠 있는 시연 스택 이름들. **서브셸이라 use_stack의 export가 새지 않는다.**
demo_stacks_up() {
  (
    for st in $DEMO_STACKS; do
      use_stack "$st" || continue
      [ -n "$(docker compose ps -q 2>/dev/null)" ] && printf '%s ' "$COMPOSE_PROJECT_NAME"
    done
  )
}

# **반대 방향도 막는다**(#181에서 찾았다). 시연 스택의 `none` 은 측정 스택과
# **같은 호스트 포트**(8080·18081·18082·5432·6379)를 쓴다 — 기본값을 그대로
# 물려받게 두어 측정 경로를 안 건드린 결과다(#179). 그래서 측정 스택이 떠 있으면
# `demo` 가 포트를 못 잡고 **절반만 뜬 채로 실패한다.**
#
# 겹쳐 띄우는 것은 어차피 (c)가 막는다 — 같이 못 도는 것이 정상이고,
# **먼저 알려 주는 것이 반쯤 뜬 것을 뒤늦게 발견하는 것보다 낫다.**
refuse_if_measure_up() {
  [ -n "$(COMPOSE_PROJECT_NAME=holdfast docker compose ps -q 2>/dev/null)" ] || return 0
  echo "[holdfast] !! 측정 스택(holdfast)이 떠 있다." >&2
  echo "[holdfast]    시연 스택의 none 이 같은 호스트 포트를 쓴다 — 함께 못 뜬다." >&2
  echo "[holdfast]    내리려면: ./holdfast down" >&2
  exit 1
}

# **측정 중에 시연 스택이 떠 있으면 안 된다**(#179 (c)). 포트가 갈려도
# CPU와 메모리를 나눠 쓰므로 concurrency-spec 7.3이 통제하려는 조건이 깨진다.
# **경고가 아니라 중단이다** — #132가 warn_stopped를 그렇게 만든 것과 같은
# 자리이고, 여기서 새는 것은 컨테이너 하나가 아니라 측정 회차 전체다.
refuse_if_demo_up() {
  local up
  up="$(demo_stacks_up)"
  [ -z "$up" ] && return 0
  echo "[holdfast] !! 시연 스택이 떠 있다: $up" >&2
  echo "[holdfast]    측정은 한 스택에서만 한다. 포트가 갈려도 CPU·메모리를" >&2
  echo "[holdfast]    나눠 쓰면 7.3의 고정 변수가 통제되지 않는다." >&2
  echo "[holdfast]    내리려면: ./holdfast demo-down" >&2
  exit 1
}

# 그 스택의 nginx 호스트 포트. 안내 문구와 터널 ingress가 이 값을 쓴다(#174).
stack_port() {
  case "$1" in
    none)        echo 8080 ;;
    pessimistic) echo 8090 ;;
  esac
}

# nginx는 기동 시 읽은 설정으로 계속 돈다. infra/nginx/nginx.conf는 바인드
# 마운트라 컨테이너 안 파일은 바로 바뀌지만, `docker compose up -d`는 마운트된
# 파일이 바뀌었다고 컨테이너를 다시 만들지 않는다. **실제로 Host 헤더 수정이
# 하루 넘게 적용되지 않아 리다이렉트에서 포트가 계속 빠졌다.**
# 이미 최신 설정이면 reload는 아무 일도 하지 않으므로 매번 부른다.
#
# **`|| true`가 실패를 삼킨다 — 지금은 안전하지만 순서에 기댄다.** 호출자가
# 모두 `wait_healthy`를 먼저 부르고, 그 검사는 nginx를 통해 나가므로 nginx가
# 죽어 있으면 여기 오기 전에 멈춘다. 순서를 바꾸거나 wait_healthy를 건너뛰는
# 경로가 생기면 그때부터는 조용한 실패가 된다(#128).
reload_nginx() {
  docker compose exec -T nginx nginx -s reload >/dev/null 2>&1 || true
}

# **멈춘 컨테이너를 먼저 알린다.** #128의 사고가 이것이었다 — nginx가 내려간
# 채로 app·db·redis만 running이라 스택이 "떠 있는" 것처럼 보였고, 그 상태로
# 폐기 측정 4번은 15회 × 120초를 죽은 로드밸런서에 부었다.
#
# wait_healthy도 결국 잡아내지만 60초를 기다린 뒤다. 여기서 보면 즉시 보이고,
# 무엇보다 **무엇이 죽었는지**를 이름으로 알려 준다.
warn_stopped() {
  local stopped
  stopped=$(docker compose ps --all --format '{{.Service}} {{.State}}' 2>/dev/null               | awk '$2 != "running" { print $1 }' | paste -sd' ' -)
  [ -z "$stopped" ] && return 0
  echo "[holdfast] !! 이 서비스가 running이 아니다: $stopped" >&2
  echo "[holdfast]    전체를 다시 올린다 — 골라 띄우면 죽은 채로 남는다." >&2
}

wait_healthy() {
  # docker compose가 Started를 돌려줘도 Spring Boot는 5~6초 더 걸린다
  # (load-test/README의 "Started는 응답할 준비가 됐다가 아니다").
  local n=0
  printf '[holdfast] 앱이 응답할 때까지 기다린다'
  while [ "$n" -lt 60 ]; do
    if docker compose exec -T nginx wget -q -O- --timeout=3 \
         http://127.0.0.1:80/api/health >/dev/null 2>&1; then
      echo " — 준비됐다."
      return 0
    fi
    printf '.'
    sleep 2
    n=$((n + 2))
  done
  echo
  echo "[holdfast] !! 60초 안에 응답하지 않았다. ./holdfast logs app1 로 확인하라." >&2
  return 1
}

cmd="${1:-}"
[ $# -gt 0 ] && shift || true

case "$cmd" in
  ''|-h|--help|help) usage ;;

  up|rebuild)
    # **`rebuild`는 `up --build`의 다른 이름이다.** 커맨드 목록에 이름으로
    # 올라와 있어야 사람이 찾는다 — #128의 원인은 다시 빌드하는 길이 없다는
    # 것이 아니라 **`holdfast` 안에서 그 길이 보이지 않는다**는 것이었고,
    # 그래서 점검이 없는 생짜 compose로 샜다.
    parse_strategy_args "$@"
    [ "$cmd" = "rebuild" ] && build="--build"

    warn_stopped
    # **서비스를 골라 띄우지 않는다.** 앱만 고쳤어도 전체를 올려야 죽어 있던
    # 컨테이너가 함께 살아난다(#128).
    if [ -n "$strategy" ]; then
      echo "[holdfast] 전략 $strategy 로 기동한다.${build:+ (다시 빌드)}"
      HOLDFAST_STRATEGY="$strategy" docker compose up -d $build
    else
      [ -n "$build" ] && echo "[holdfast] 이미지를 다시 빌드한다."
      docker compose up -d $build
    fi
    wait_healthy
    reload_nginx
    ;;

  down) docker compose down ;;

  # **시연 스택은 프로젝트가 달라 `down`이 안 건드린다**(#179). 내리는 길이
  # 이름으로 보여야 한다 — #128·#132가 같은 이유로 `rebuild`를 서브커맨드로 뒀다.
  demo-down)
    for st in $DEMO_STACKS; do
      use_stack "$st"
      echo "[holdfast] $COMPOSE_PROJECT_NAME 내린다."
      docker compose down
    done
    ;;
  ps)   docker compose ps ;;
  logs) docker compose logs -f --tail 100 "${1:-app1}" ;;

  seed)     "$S/seed.sh" "$@" ;;
  measure)   refuse_if_demo_up; "$S/measure.sh" "$@" ;;
  deadlock)  refuse_if_demo_up; "$S/run-deadlock.sh" "$@" ;;
  sustained) refuse_if_demo_up; "$S/run-sustained.sh" "$@" ;;
  verify)   "$S/verify.sh" "$@" ;;
  summary)  node_run "$S/summarize.mjs" "$@" ;;

  test)
    if [ $# -gt 0 ]; then
      (cd api && ./gradlew test --tests "$1")
    else
      (cd api && ./gradlew test)
    fi
    ;;
  build) (cd api && ./gradlew build -x test) ;;

  demo)
    # **시연 중에 코드를 고치는 일이 실제로 있었다.** 그때 생짜 compose로 다시
    # 띄우면 점검이 빠진다 — `--build`를 여기에도 둔다(#128).
    #
    # **여는 것이 기본이고 `--no-open`으로 끈다.** 플래그를 켜야 열리게 두면
    # 발표자가 그것을 잊고, 그러면 손으로 넷을 열게 된다.
    no_open=""
    build=""
    for a in "$@"; do
      case "$a" in
        --no-open) no_open="yes" ;;
        --build)   build="--build" ;;
        none|pessimistic|optimistic|unique|redis)
          # **전략 인자를 받지 않는다**(#179). 두 스택을 모두 띄우므로 고를 것이
          # 없고, 받으면 "한쪽만 떴나"를 의심하게 된다.
          echo "[holdfast] demo 는 전략 인자를 받지 않는다 — $DEMO_STACKS 를 모두 띄운다." >&2
          echo "[holdfast]    시연 중 전환은 탭으로 한다(#179)." >&2
          echo "[holdfast]    한 전략만 띄우려면: ./holdfast up $a" >&2
          exit 2 ;;
        *) echo "[holdfast] 모르는 인자: $a" >&2; exit 2 ;;
      esac
    done

    refuse_if_measure_up

    echo "[holdfast] 시연 준비 — 스택 둘($DEMO_STACKS) · 시나리오 $DEMO_SCENARIO${build:+ (다시 빌드)}"

    # **한 스택씩 끝까지 세운다.** 둘을 동시에 올리면 어느 쪽이 실패했는지
    # 로그가 섞이고, seed.sh가 어느 DB를 잡았는지도 흐려진다.
    for st in $DEMO_STACKS; do
      use_stack "$st"
      echo
      echo "[holdfast] ── $st  ($COMPOSE_PROJECT_NAME · nginx :$(stack_port "$st"))"
      warn_stopped
      # **시연은 actuator를 좁혀 띄운다**(#156). 터널이 집 PC를 인터넷에 내놓는데
      # (2.1), metrics 75개에 힙·커넥션 풀·JVM 정보가 다 들어 있다.
      HOLDFAST_STRATEGY="$st" HOLD_TTL_SECONDS="$DEMO_HOLD_TTL_SECONDS" HOLDFAST_ACTUATOR_EXPOSURE="health" docker compose up -d $build
      wait_healthy
      reload_nginx
      # U-2는 전략에 따라 있고 없다(erd 3.1). 시드가 그 판단을 하므로 스택마다 돈다.
      "$S/seed.sh" "$DEMO_SCENARIO" "$st"
    done

    none_port="$(stack_port none)"
    pess_port="$(stack_port pessimistic)"
    # **탭이 넷이 됐다.** 1절이 none 탭에서 시작해 pess 탭으로 넘어간다 —
    # 그 전환이 이 이슈가 터미널을 대신하는 방식이다.
    DEMO_TABS="http://localhost:${none_port}/demo/race http://localhost:${pess_port}/demo/race http://localhost:${pess_port}/ http://localhost:${pess_port}/admin/programs"
    cat <<EOF

════ 시연 주소 ════
  홀드 TTL은 시연용 ${DEMO_HOLD_TTL_SECONDS}초다(측정 기본값 10초는 설명 중에 풀린다).

  **전략 전환은 탭 전환이다.** 두 스택이 같이 떠 있다(#179).

  [1절 전반] none        http://localhost:${none_port}/demo/race
  [1절 후반·2절] pess    http://localhost:${pess_port}/demo/race
  좌석맵(pess)           http://localhost:${pess_port}/sessions/1?userId=1
                         http://localhost:${pess_port}/sessions/1?userId=2
  검표(pess)             http://localhost:${pess_port}/scan
  프로그램·회차(pess)    http://localhost:${pess_port}/admin/programs

  **3절은 pess 스택이다.** 거기서 만든 회차라야 같은 DB의 사용자 화면에 보인다.
  none 쪽 /admin 은 쓰지 않는다.

  **DB가 갈려 있다.** none에서 깨뜨린 상태가 그대로 남으므로 탭을 되돌리면
  "아까 그것"을 다시 보일 수 있다.

  **첫 실행은 한 번 눌러 버리고 시작하라.** JVM이 데워지기 전 첫 묶음은
  일부 요청이 연결 단계에서 실패한다(실측에서 첫 시도만 그랬다).
EOF

    # **여기서부터가 편의다. 실패해도 위의 준비는 이미 끝났다.**
    if [ -n "$no_open" ]; then
      echo "[holdfast] --no-open — 탭과 대본을 열지 않는다."
    else
      OPENER="$(opener)"
      echo
      echo "════ 여는 중 ════"
      if [ -z "$OPENER" ]; then
        echo "[holdfast]   !! 브라우저를 여는 명령이 없다(start·open·xdg-open)." >&2
        echo "[holdfast]      위 주소를 직접 연다. 준비 자체는 끝났다." >&2
      elif open_demo_tabs; then
        echo "[holdfast]   탭 1  동시 요청(none)  http://localhost:${none_port}/demo/race"
        echo "[holdfast]   탭 2  동시 요청(pess)  http://localhost:${pess_port}/demo/race"
        echo "[holdfast]   탭 3  프로그램 목록    http://localhost:${pess_port}/"
        echo "[holdfast]   탭 4  프로그램·회차    http://localhost:${pess_port}/admin/programs"
        echo "[holdfast]   번호는 대본의 탭 번호와 같다. **1절은 탭 1에서 시작해 탭 2로 넘어간다.**"
      else
        echo "[holdfast]   !! 탭을 다 열지 못했다. 위 주소를 직접 연다." >&2
      fi
      open_script
    fi
    ;;

  # ── 터널 (#174) ───────────────────────────────────────────────────────
  #
  # **`demo` 에 붙이지 않는다.** 2.1이 "시연 직전에 열고 직후에 닫는다"로 정했고,
  # `demo` 는 리허설에서 여러 번 부른다. 함께 띄우면 상시로 두는 것과 같아진다.
  tunnel)
    sub="${1:-up}"
    case "$sub" in
      up)
        [ -f infra/tunnel/credentials.json ] || {
          echo "[holdfast] !! infra/tunnel/credentials.json 이 없다." >&2
          echo "[holdfast]    infra/tunnel/README.md 의 준비 절차를 먼저 한다." >&2
          exit 1; }
        [ -n "${TUNNEL_ID:-}" ] || {
          echo "[holdfast] !! TUNNEL_ID 가 없다. .env 에 넣거나 앞에 붙여 부른다." >&2
          exit 1; }

        # **오리진이 먼저 서 있어야 한다.** 터널만 뜨면 밖에서 502가 보이고,
        # 그것을 "Access가 막았다"로 착각한다.
        up="$(demo_stacks_up)"
        case " $up " in
          *" holdfast-none "*) ;;
          *) echo "[holdfast] !! 시연 스택이 안 떠 있다. ./holdfast demo 를 먼저 한다." >&2; exit 1 ;;
        esac

        echo "[holdfast] 터널을 띄운다."
        COMPOSE_PROJECT_NAME=holdfast-tunnel docker compose -f docker-compose.tunnel.yml up -d
        echo "[holdfast] 엣지에 전파될 때까지 기다린다."
        sleep 10
        tunnel_verify || {
          echo "[holdfast] !! 확인에 실패했다. **터널을 닫는다.**" >&2
          echo "[holdfast]    열린 채로 멈추는 것이 최악이다(#174)." >&2
          COMPOSE_PROJECT_NAME=holdfast-tunnel docker compose -f docker-compose.tunnel.yml down >/dev/null 2>&1
          exit 1; }
        echo
        echo "[holdfast] 터널 준비됐다. 발표장에서 열 주소:"
        for h in $TUNNEL_HOSTS; do echo "[holdfast]   https://$h/"; done
        echo "[holdfast] 시연이 끝나면: ./holdfast tunnel down"
        ;;
      down)
        COMPOSE_PROJECT_NAME=holdfast-tunnel docker compose -f docker-compose.tunnel.yml down
        echo "[holdfast] 터널을 닫았다."
        ;;
      verify) tunnel_verify ;;
      *) echo "tunnel up|down|verify" >&2; exit 2 ;;
    esac
    ;;

  strategy)
    s="${1:?전략을 지정한다: none|pessimistic|optimistic|unique|redis}"
    case "$s" in none|pessimistic|optimistic|unique|redis) ;;
      *) echo "전략은 none|pessimistic|optimistic|unique|redis 중 하나다: $s" >&2; exit 2 ;; esac
    echo "[holdfast] 전략을 $s 로 바꾼다 — 앱 2대만 다시 띄운다."
    # **이 경로만 서비스를 골라 띄운다.** 13초에 끝나는 것이 값이라 그렇게 두되,
    # 골라 띄우면 나머지가 죽은 채로 남으므로 먼저 알린다(#128).
    warn_stopped
    HOLDFAST_STRATEGY="$s" HOLD_TTL_SECONDS="$DEMO_HOLD_TTL_SECONDS"       docker compose up -d app1 app2
    wait_healthy
    # U-2는 전략에 따라 있고 없다(erd 3.1). 시드가 그 판단을 하므로 함께 돌린다.
    "$S/seed.sh" "$DEMO_SCENARIO" "$s"
    echo "[holdfast] 전략 $s 준비됐다. 데모 화면은 자동으로 갱신된다."
    ;;

  bundle)
    # **docs/status.md 하나로 파악할 수 있게 만든 묶음이다.**
    #
    # 다른 사람이나 새 AI 세션에 컨텍스트로 넣는 것이 용도라, 판단이 담긴
    # 문서만 넣고 **부피만 큰 것은 뺀다.**
    #
    #   빼는 것: docs/results/*.json — k6 요약 원본 24개(216KB)다. 판정에 쓰인
    #            숫자는 이미 m3-conclusion과 concurrency-spec 7.6의 표에 있고,
    #            원본은 임계값·메트릭 버킷이 대부분이라 읽는 쪽에 도움이 안 된다
    #   애초에 없는 것: load-test/results/ 는 .gitignore 대상이라 저장소에 없다
    #
    # **HEAD 기준이다.** git archive가 커밋된 것만 담으므로, 방금 고친 문서를
    # 넣으려면 먼저 커밋해야 한다. 아래에서 그 사실을 확인해 알려준다.
    out="${1:-holdfast-docs-$(date +%Y%m%d).zip}"

    if ! git diff --quiet HEAD -- docs README.md 2>/dev/null; then
      echo "[holdfast] !! docs/에 커밋되지 않은 변경이 있다. 묶음은 HEAD 기준이라 빠진다." >&2
    fi

    git archive --format=zip -o "$out" HEAD README.md 'docs/*.md' docs/openapi.yaml
    # ls-tree가 아니라 ls-files다 — ls-tree의 경로지정자는 여기서 두 개만
    # 잡는다(디렉토리 경계를 넘지 않는다).
    n=$(git ls-files -- README.md 'docs/*.md' docs/openapi.yaml | wc -l)
    echo "[holdfast] $out — 문서 ${n}개"
    echo "[holdfast] 먼저 읽을 것: docs/status.md"
    ;;

  race)
    cat <<'EOF'
동시 요청 데모: http://localhost:8080/demo/race

  좌석 하나에 N개 요청을 동시에 보내 전략별 차이를 화면으로 본다.
  none 이면 홀드가 여러 건, 전략을 걸면 1건이다.

  준비:  ./holdfast demo none        (또는 pessimistic 등)
EOF
    ;;

  *)
    echo "알 수 없는 커맨드: $cmd" >&2
    echo >&2
    usage >&2
    exit 2
    ;;
esac
