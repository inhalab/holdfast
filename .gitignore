# --- Java / Gradle ---
build/
.gradle/
*.class
*.jar
!**/gradle/wrapper/gradle-wrapper.jar

# --- Node ---
node_modules/
dist/

# --- Terraform (이거 빠지면 AWS 리소스 정보가 통째로 공개됩니다) ---
.terraform/
.terraform.lock.hcl
*.tfstate
*.tfstate.*
*.tfvars
!example.tfvars
crash.log

# --- 환경변수 / 자격증명 ---
.env
.env.*
*.pem
*.key

# --- 부하 테스트 결과 ---
# 원본 JSON은 load-test/results/에 남기고, 채택한 확정 측정본만
# docs/results/로 옮겨 커밋한다 (concurrency-spec 7.4-5, load-test/README).
load-test/results/*.json
load-test/results/*.txt
!load-test/results/.gitkeep

# --- IDE / OS ---
.idea/
.vscode/
*.iml
.DS_Store
