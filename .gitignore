# --- Java / Gradle ---
build/
.gradle/
*.class
*.jar
!**/gradle/wrapper/gradle-wrapper.jar

# --- Node ---
node_modules/
dist/

# --- Terraform (이거 빠지면 AWS 리소스 정보가 통째로 공개됩니다) ---
.terraform/
.terraform.lock.hcl
*.tfstate
*.tfstate.*
*.tfvars
# apply 시각 스탬프. holdfast 가 경과 시간을 재는 데 쓴다(#42).
infra/terraform/.aws-up-at
infra/terraform/.tfplan
!example.tfvars
crash.log

# --- 환경변수 / 자격증명 ---
.env
.env.*
*.pem
*.key

# --- 부하 테스트 결과 ---
# 원본 JSON은 load-test/results/에 남기고, 채택한 확정 측정본만
# docs/results/로 옮겨 커밋한다 (concurrency-spec 7.4-7, load-test/README).
#
# **하위 디렉토리까지 통째로 무시한다.** 예전 규칙은 *.json / *.txt 두 줄이라
# results/discarded/... 처럼 한 단계 아래로 내려간 파일이 걸리지 않았다.
# 폐기분을 격리하면서 그것이 커밋 대상으로 잡히는 것을 확인하고 고쳤다.
load-test/results/*
!load-test/results/.gitkeep

# --- 제출물 ---
# 수업 제출물(PPT 등)은 바이너리라 diff가 안 되고 저장소를 무겁게 만든다.
# 파일은 저장소 밖에 두고, 무엇을 제출했고 그 판단이 어느 문서에 대응하는지만
# docs/submissions/README.md에 남긴다.
#
# **README.md 와 .gitkeep 말고는 아무것도 커밋하지 않는다.**
#
# 한때 `docs/submissions/*.pptx` 만 무시했고, 그 옆에
# *"확장자를 넓게 잡지 않는다 — 통째로 무시하면 README까지 걸린다"* 고 적혀
# 있었다. **넓게 잡되 README 와 .gitkeep 을 되살리면 된다** — 그 걱정은
# 예외 두 줄로 해소된다.
#
# **넓게 잡는 이유는 확장자가 아니라 내용이다.** `*.pptx` 만 막으면 마크다운은
# 통과하고, 실제로 발표자 노트가 그렇게 들어왔다(#224). **저장소가 공개라
# 「안 할 말」과 예상 질문까지 함께 공개된다.** 제출물은 저장소 밖이고 노트도
# 제출물이다.
docs/submissions/*
!docs/submissions/README.md
!docs/submissions/.gitkeep

# --- 시연 대본 렌더링 결과 ---
# `./holdfast demo`가 docs/demo-script.md를 HTML로 만들어 build/에 둔다(#146).
# **생성물이라 커밋하지 않는다** — 원문이 바뀌면 달라지고, 원문이 정본이다.
#
# 위 `build/` 한 줄에 이미 걸리지만 그 줄은 Gradle 산출물을 위한 것이다.
# 우연히 걸리는 것과 그러기로 정한 것은 다르므로 여기 적는다.
build/demo-script.html

# --- IDE / OS ---
.idea/
.vscode/
*.iml
.DS_Store

# --- Cloudflare Tunnel (이거 빠지면 터널 자격증명이 통째로 공개됩니다) ---
infra/tunnel/credentials.json
infra/tunnel/*.json
!infra/tunnel/credentials.example.json
.env

# --- 발표 자료 생성기의 산출물 (tools/deck) ---
# **정본은 스크립트다**(#217). 아래는 전부 그 스크립트가 만드는 것이라
# 커밋하지 않는다 — 넣으면 「무엇이 정본인가」가 다시 둘이 된다.
tools/deck/build/
tools/deck/preview*/
tools/deck/*.pptx
__pycache__/
*.pyc
