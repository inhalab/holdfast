# --- Java / Gradle ---
build/
.gradle/
*.class
*.jar
!**/gradle/wrapper/gradle-wrapper.jar

# --- Node ---
node_modules/
dist/

# --- Terraform (이거 빠지면 AWS 리소스 정보가 통째로 공개됩니다) ---
.terraform/
.terraform.lock.hcl
*.tfstate
*.tfstate.*
*.tfvars
!example.tfvars
crash.log

# --- 환경변수 / 자격증명 ---
.env
.env.*
*.pem
*.key

# --- 부하 테스트 결과 ---
# 원본 JSON은 load-test/results/에 남기고, 채택한 확정 측정본만
# docs/results/로 옮겨 커밋한다 (concurrency-spec 7.4-7, load-test/README).
#
# **하위 디렉토리까지 통째로 무시한다.** 예전 규칙은 *.json / *.txt 두 줄이라
# results/discarded/... 처럼 한 단계 아래로 내려간 파일이 걸리지 않았다.
# 폐기분을 격리하면서 그것이 커밋 대상으로 잡히는 것을 확인하고 고쳤다.
load-test/results/*
!load-test/results/.gitkeep

# --- 제출물 ---
# 수업 제출물(PPT 등)은 바이너리라 diff가 안 되고 저장소를 무겁게 만든다.
# 파일은 저장소 밖에 두고, 무엇을 제출했고 그 판단이 어느 문서에 대응하는지만
# docs/submissions/README.md에 남긴다.
#
# **확장자를 넓게 잡지 않는다.** docs/submissions/* 로 통째로 무시하면 그
# README까지 걸린다. 새 형식이 오면 한 줄 더한다.
docs/submissions/*.pptx

# --- 시연 대본 렌더링 결과 ---
# `./holdfast demo`가 docs/demo-script.md를 HTML로 만들어 build/에 둔다(#146).
# **생성물이라 커밋하지 않는다** — 원문이 바뀌면 달라지고, 원문이 정본이다.
#
# 위 `build/` 한 줄에 이미 걸리지만 그 줄은 Gradle 산출물을 위한 것이다.
# 우연히 걸리는 것과 그러기로 정한 것은 다르므로 여기 적는다.
build/demo-script.html

# --- IDE / OS ---
.idea/
.vscode/
*.iml
.DS_Store
